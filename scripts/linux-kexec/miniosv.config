# Departures from the Graviton reference config (graviton.symbols), applied
# on top of it. Every line here must survive into the final .config.

# The rest of the kexec feature set arm64 offers, which Amazon Linux leaves
# off: Kexec HandOver (preserve memory across kexec; boot with kho=on) with
# its debugfs control files and debug checks.
CONFIG_KEXEC_HANDOVER=y
CONFIG_KEXEC_HANDOVER_DEBUG=y
CONFIG_KEXEC_HANDOVER_DEBUGFS=y

# kexec_load() needs ARCH_SUPPORTS_KEXEC, which is PM_SLEEP_SMP. Graviton gets
# PM_SLEEP from HIBERNATION, but hibernation needs swap on a block device and
# this image has no disks, so take PM_SLEEP from suspend instead.
CONFIG_SUSPEND=y

# Keep every module-signing knob except the signing of in-tree modules (there
# are none) and module compression. MODULE_SIG pulls in the system trusted
# keyring that KEXEC_SIG checks kexec_file_load() images against; its build
# also generates certs/signing_key.pem, which can sign an Image for that check.
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODVERSIONS is not set

# KASLR, which Graviton leaves off. kexec_file_load() always puts a fresh
# kaslr-seed into the handover DTB (drivers/of/kexec.c) and only a KASLR
# kernel zeroes it at boot; kexec-tools refuses to kexec_load() from a kernel
# whose DTB still carries one, so without this a kexec -c after a kexec -s fails.
CONFIG_RANDOMIZE_BASE=y

# Not Graviton, but useful here: /proc/config.gz shows what was built.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
